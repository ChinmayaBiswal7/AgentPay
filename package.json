{
  "name": "agentpay",
  "version": "1.0.0",
  "description": "AgentPay — AI-Powered Shopping and Payment Agent for PayPal Hackathon",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "node server/index.js",
    "test": "node --test server/tests/*.test.js",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install"
  },
  "keywords": [
    "paypal",
    "ai-agent",
    "hackathon",
    "e-commerce",
    "shopping-agent"
  ],
  "author": "AgentPay Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
